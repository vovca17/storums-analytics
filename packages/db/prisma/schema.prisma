// Схема данных Storums. Деньги — Decimal(14,2), периоды начислений — строка "YYYY-MM".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TaxRegime {
  NPD
  NDFL
  USN6
  NONE
}

enum SubscriptionPlan {
  BETA
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum PropertyStatus {
  RENTED
  VACANT
  RENOVATION
  ARCHIVED
}

enum UtilitiesPaidBy {
  OWNER
  TENANT
  SPLIT
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  UTILITY_CALC
  LEASE_SCHEDULE
  IMPORT
  BOOKING
}

enum BookingPlatform {
  DIRECT
  AVITO
  SUTOCHNO
  OSTROVOK
  YANDEX
  OTHER
}

enum MeterKind {
  COLD_WATER
  HOT_WATER
  WATER_DISPOSAL
  ELECTRICITY
  ELECTRICITY_DAY
  ELECTRICITY_NIGHT
  GAS
  HEAT
}

enum EventKind {
  CLEANING
  METER_READINGS
  PAYMENT
  REPAIR
  OTHER
}

enum Recurrence {
  NONE
  MONTHLY
  YEARLY
}

enum FixedChargeCalc {
  FIXED
  PER_M2
  PER_PERSON
}

/// id совпадает с auth.users.id в Supabase
model User {
  id        String    @id @db.Uuid
  email     String    @unique
  name      String?
  taxRegime TaxRegime @default(NPD)
  /// Порядок и состав блоков дашборда (массив id); null — по умолчанию
  dashboardLayout Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subscription Subscription?
  properties   Property[]
  tenants      Tenant[]
  categories   Category[]
  tariffs      Tariff[]
  files        File[]
  events       Event[]
}

/// Удалённые аккаунты: токены, выданные до deletedAt, API не принимает и пользователя заново не создаёт
model DeletedUser {
  id        String   @id @db.Uuid
  deletedAt DateTime @default(now())
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @unique @db.Uuid
  plan             SubscriptionPlan   @default(BETA)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  /// Платёжный провайдер (yookassa и т.п.) — появится после беты
  provider         String?
  externalId       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id            String         @id @default(uuid()) @db.Uuid
  ownerId       String         @db.Uuid
  title         String
  address       String
  /// Код региона РФ ("77" — Москва), по нему выбираются тарифы
  regionCode    String
  areaM2        Decimal        @db.Decimal(8, 2)
  residents     Int            @default(1)
  purchasePrice Decimal?       @db.Decimal(14, 2)
  purchaseDate  DateTime?      @db.Date
  status        PropertyStatus @default(VACANT)
  /// Ипотека: { principal, ratePct, monthlyPayment, endDate }
  mortgage      Json?
  /// Сдаётся посуточно: на странице квартиры появляются брони и календарь
  dailyRent     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leases       Lease[]
  transactions Transaction[]
  meters       Meter[]
  fixedCharges FixedCharge[]
  utilityBills UtilityBill[]
  events       Event[]
  bookings     Booking[]

  @@index([ownerId])
}

model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  ownerId       String   @db.Uuid
  fullName      String
  phone         String?
  email         String?
  /// Юрлицо или ИП: для НПД ставка 6% вместо 4%
  isLegalEntity Boolean  @default(false)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leases Lease[]

  @@index([ownerId])
}

model Lease {
  id              String          @id @default(uuid()) @db.Uuid
  propertyId      String          @db.Uuid
  tenantId        String          @db.Uuid
  startDate       DateTime        @db.Date
  endDate         DateTime?       @db.Date
  rentAmount      Decimal         @db.Decimal(14, 2)
  /// День месяца, до которого арендатор платит (1–28)
  paymentDay      Int             @default(1)
  deposit         Decimal?        @db.Decimal(14, 2)
  utilitiesPaidBy UtilitiesPaidBy @default(OWNER)
  fileId          String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  file         File?         @relation(fields: [fileId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([propertyId])
  @@index([tenantId])
}

/// ownerId = null — системная статья, видна всем
model Category {
  id        String          @id @default(uuid()) @db.Uuid
  ownerId   String?         @db.Uuid
  name      String
  type      TransactionType
  parentId  String?         @db.Uuid
  icon      String?
  /// Стабильный ключ системной статьи ("rent", "utilities", ...)
  systemKey String?         @unique
  createdAt DateTime        @default(now())

  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]

  @@index([ownerId])
}

model Transaction {
  id           String            @id @default(uuid()) @db.Uuid
  propertyId   String            @db.Uuid
  categoryId   String            @db.Uuid
  leaseId      String?           @db.Uuid
  /// За какой месяц получена аренда; date — фактический день поступления денег
  rentPeriod   String?           @db.VarChar(7)
  /// Повтор отправки формы платежа не создаёт второй доход
  paymentKey   String?           @unique @db.Uuid
  type         TransactionType
  amount       Decimal           @db.Decimal(14, 2)
  date         DateTime          @db.Date
  comment      String?
  source       TransactionSource @default(MANUAL)
  /// Для плановых платежей по договору: false — ожидается, true — получен
  isPaid       Boolean           @default(true)
  attachmentId String?           @db.Uuid
  /// Операции, созданные из оплаченной брони (доход и комиссия площадки)
  bookingId    String?           @db.Uuid
  /// Расход, созданный отметкой «сделано» у события; при удалении события остаётся
  eventCompletionId String?      @unique @db.Uuid
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  eventCompletion EventCompletion? @relation(fields: [eventCompletionId], references: [id], onDelete: SetNull)
  booking     Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  lease       Lease?       @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  attachment  File?        @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  utilityBill UtilityBill?

  @@index([propertyId, date])
  @@index([categoryId])
  @@index([leaseId, rentPeriod])
}

model Meter {
  id              String    @id @default(uuid()) @db.Uuid
  propertyId      String    @db.Uuid
  kind            MeterKind
  serial          String?
  /// Дата следующей поверки — для напоминания
  verificationDue DateTime? @db.Date
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  readings MeterReading[]

  @@index([propertyId])
}

model MeterReading {
  id        String   @id @default(uuid()) @db.Uuid
  meterId   String   @db.Uuid
  period    String
  value     Decimal  @db.Decimal(12, 3)
  createdAt DateTime @default(now())

  meter Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@unique([meterId, period])
}

/// ownerId = null — справочный региональный тариф; иначе своя ставка пользователя (важнее справочной)
model Tariff {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String?   @db.Uuid
  regionCode String
  kind       MeterKind
  unit       String
  price      Decimal   @db.Decimal(10, 4)
  validFrom  DateTime  @db.Date
  validTo    DateTime? @db.Date
  source     String?

  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([regionCode, kind, validFrom])
}

model FixedCharge {
  id         String          @id @default(uuid()) @db.Uuid
  propertyId String          @db.Uuid
  name       String
  calc       FixedChargeCalc
  rate       Decimal         @db.Decimal(10, 2)
  createdAt  DateTime        @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model UtilityBill {
  id            String   @id @default(uuid()) @db.Uuid
  propertyId    String   @db.Uuid
  period        String
  /// Строки начислений из calcUtilityBill (@storums/shared)
  lines         Json
  total         Decimal  @db.Decimal(14, 2)
  transactionId String?  @unique @db.Uuid
  createdAt     DateTime @default(now())

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([propertyId, period])
}

/// Файл в Supabase Storage
model File {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  bucket    String
  path      String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leases       Lease[]
  transactions Transaction[]

  @@unique([bucket, path])
}

/// Событие владельца: клининг, передача показаний, платёж… Повторы разворачиваются в даты на лету.
model Event {
  id               String     @id @default(uuid()) @db.Uuid
  ownerId          String     @db.Uuid
  /// null — событие не про конкретную квартиру
  propertyId       String?    @db.Uuid
  title            String
  kind             EventKind  @default(OTHER)
  /// Дата (первого) события; для MONTHLY берётся число месяца, для YEARLY — день и месяц
  date             DateTime   @db.Date
  recurrence       Recurrence @default(NONE)
  /// За сколько дней до даты событие попадает в напоминания
  remindDaysBefore Int        @default(1)
  amount           Decimal?   @db.Decimal(14, 2)
  comment          String?
  /// Отметка «сделано» создаёт расход на сумму события
  countAsExpense   Boolean    @default(false)
  createdAt        DateTime   @default(now())

  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property    Property?         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  completions EventCompletion[]

  @@index([ownerId])
  @@index([propertyId])
}

/// Отметка «сделано / оплачено» для одного повтора события
model EventCompletion {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @db.Uuid
  occurrenceDate DateTime @db.Date
  doneAt         DateTime @default(now())

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@unique([eventId, occurrenceDate])
}

/// Посуточная бронь. Ночи: с checkIn до checkOut (день выезда свободен для следующего гостя).
model Booking {
  id          String          @id @default(uuid()) @db.Uuid
  propertyId  String          @db.Uuid
  guestName   String
  guestPhone  String?
  checkIn     DateTime        @db.Date
  checkOut    DateTime        @db.Date
  /// Сколько заплатил гость за проживание
  amount      Decimal         @db.Decimal(14, 2)
  cleaningFee Decimal?        @db.Decimal(14, 2)
  /// Комиссия площадки — уходит в расходы
  commission  Decimal?        @db.Decimal(14, 2)
  platform    BookingPlatform @default(DIRECT)
  isPaid      Boolean         @default(false)
  comment     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([propertyId, checkIn])
}
