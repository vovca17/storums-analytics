    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.8",
    "@storums/db": "workspace:*",
    "@storums/shared": "workspace:*",
    "jose": "5.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
